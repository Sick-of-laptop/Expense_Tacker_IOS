        "import pandas as pd\n",
        "\n",
        "# UCI direct files\n",
        "DATA_URL = \"http://www.archive.ics.uci.edu/ml/machine-learning-databases/heart-disease/processed.cleveland.data\"\n",
        "NAMES_URL = \"http://www.archive.ics.uci.edu/ml/machine-learning-databases/heart-disease/heart-disease.names\"\n",
        "\n",
        "# Column names taken from the UCI names file\n",
        "cols = [\"age\",\"sex\",\"cp\",\"trestbps\",\"chol\",\"fbs\",\"restecg\",\"thalach\",\"exang\",\n",
        "        \"oldpeak\",\"slope\",\"ca\",\"thal\",\"num\"]\n",
        "\n",
        "# Load; UCI uses '?' as missing-value marker\n",
        "df = pd.read_csv(DATA_URL, header=None, names=cols, na_values=[\"?\"])\n",
        "\n",
        "# Make a clean copy (drop rows with any missing).\n",
        "# (You can switch to imputation later; this gets you started.)\n",
        "df_clean = df.dropna().copy()\n",
        "\n",
        "# Binary target: presence if num > 0\n",
        "df_clean[\"target\"] = (df_clean[\"num\"] > 0).astype(int)\n",
        "df_clean = df_clean.drop(columns=[\"num\"])\n",
        "\n",
        "df_clean.head(), df_clean.shape, df_clean[\"target\"].value_counts()"
      ]
