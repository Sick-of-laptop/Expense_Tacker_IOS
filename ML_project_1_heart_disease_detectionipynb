        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "from sklearn.svm import SVC\n",
        "\n",
        "# MLP: small, fast, good baseline. Early stopping prevents overfitting.\n",
        "mlp = MLPClassifier(hidden_layer_sizes=(64, 32),\n",
        "                    activation=\"relu\",\n",
        "                    max_iter=1000,\n",
        "                    early_stopping=True,\n",
        "                    random_state=42)\n",
        "\n",
        "# SVM (RBF): strong margin-based classifier. Good default C/gamma.\n",
        "svm = SVC(kernel=\"rbf\", C=1.0, gamma=\"scale\", probability=False, random_state=42)\n",
        "\n",
        "pipe_mlp = Pipeline([(\"scaler\", StandardScaler()), (\"clf\", mlp)])\n",
        "pipe_svm = Pipeline([(\"scaler\", StandardScaler()), (\"clf\", svm)])\n"
